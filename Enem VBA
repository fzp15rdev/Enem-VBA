'Option Explicit

Public DataArr As Variant
Public HeaderArr As Variant
Public FilteredArr As Variant
Public DataLoaded As Boolean

Public Sub ShowEnemAnalyzer()
    frmEnem.Show vbModeless
End Sub

Public Function SafeRows(arr As Variant) As Long
    On Error GoTo Erro
