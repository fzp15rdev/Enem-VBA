' UserForm: frmEnem
Option Explicit

Private Sub UserForm_Initialize()
    lblTitle.Caption = "📊 ENEM 2015 - Analisador de Escolas"
    lblStatus.Caption = "⚠️ Nenhum arquivo carregado"
    lblInfo.Caption = "Registros: 0 | Filtrados: 0"
    lstColumns.Clear
    lstData.Clear
End Sub

Private Sub btnExtrair_Click()
    Dim url As String
    url = "https://especiais.g1.globo.com/educacao/enem/2015/enem-2015-medias-por-escola/"
    btnExtrair.Enabled = False
    lblStatus.Caption = "⏳ Extraindo dados..."
    DoEvents
    If ExtractDataFromSite(url) Then
        lblStatus.Caption = "✅ Extração concluída - Linhas: " & IIf((Not (Not DataArr)), UBound(DataArr, 1) + 1, 0)
        PopulateColumns
        UpdateTableFromFiltered
    Else
        lblStatus.Caption = "❌ Falha na extração"
        MsgBox "Erro ao extrair dados. Tente carregar arquivo manualmente.", vbExclamation
    End If
    btnExtrair.Enabled = True
End Sub

Private Sub btnCarregar_Click()
    btnCarregar.Enabled = False
    lblStatus.Caption = "⏳ Carregando arquivo..."
    DoEvents
    If LoadExcelToMemory("") Then
        lblStatus.Caption = "✅ Arquivo carregado - Linhas: " & IIf((Not (Not DataArr)), UBound(DataArr, 1) + 1, 0)
        PopulateColumns
        UpdateTableFromFiltered
    Else
        lblStatus.Caption = "❌ Erro ao carregar arquivo"
        MsgBox "Erro ao carregar o arquivo Excel.", vbExclamation
    End If
    btnCarregar.Enabled = True
End Sub

Private Sub PopulateColumns()
    Dim i As Long
    lstColumns.Clear
    If (Not (Not HeaderArr)) Then
        For i = 0 To UBound(HeaderArr)
            lstColumns.AddItem HeaderArr(i)
            ' selecionar todos por padrão
            lstColumns.Selected(lstColumns.ListCount - 1) = True
        Next i
    End If
End Sub

Private Sub UpdateTableFromFiltered()
    ' Constrói uma array (0-based rows, cols) com as colunas selecionadas e popula lstData
    If Not DataLoaded Then Exit Sub
    Dim selCols() As Long
    Dim i As Long, j As Long, k As Long
    Dim nCols As Long, nRows As Long
    Dim arrOut() As Variant
    
    ' coletar índices das colunas selecionadas
    ReDim selCols(0 To -1)
    For i = 0 To lstColumns.ListCount - 1
        If lstColumns.Selected(i) Then
            k = UBound(selCols) + 1
            ReDim Preserve selCols(0 To k)
            selCols(k) = i
        End If
    Next i
    If (UBound(selCols) < 0) Then
        MsgBox "Selecione pelo menos uma coluna!", vbExclamation
        Exit Sub
    End If
    
    If (Not (Not FilteredArr)) Then
        nRows = UBound(FilteredArr, 1) - LBound(FilteredArr, 1) + 1
        nCols = UBound(selCols) - LBound(selCols) + 1
    Else
        nRows = 0
        nCols = 0
    End If
    
    lstData.Clear
    lstData.ColumnCount = nCols
    If nRows > 0 Then
        ReDim arrOut(0 To nRows - 1, 0 To nCols - 1)
        For i = 0 To nRows - 1
            For j = 0 To nCols - 1
                arrOut(i, j) = FilteredArr(i, selCols(j))
            Next j
        Next i
        lstData.List = arrOut
    End If
    
    lblInfo.Caption = "Registros: " & IIf((Not (Not DataArr)), UBound(DataArr, 1) + 1, 0) & " | Filtrados: " & nRows
End Sub

Private Sub btnAplicar_Click()
    Dim nm As Variant, nx As Variant
    nm = Null
    nx = Null
    If Trim$(txtNotaMin.Value) <> "" Then
        If IsNumeric(txtNotaMin.Value) Then nm = CDbl(txtNotaMin.Value) Else nm = Null
    End If
    If Trim$(txtNotaMax.Value) <> "" Then
        If IsNumeric(txtNotaMax.Value) Then nx = CDbl(txtNotaMax.Value) Else nx = Null
    End If
    
    If Not ApplyFilters(txtEscola.Value, txtEstado.Value, txtCidade.Value, nm, nx) Then
        MsgBox "Erro ao aplicar filtros.", vbExclamation
        Exit Sub
    End If
    UpdateTableFromFiltered
    MsgBox "✅ Filtros aplicados. Registros encontrados: " & IIf((Not (Not FilteredArr)), UBound(FilteredArr, 1) + 1, 0), vbInformation
End Sub

Private Sub btnLimpar_Click()
    txtEscola.Value = ""
    txtEstado.Value = ""
    txtCidade.Value = ""
    txtNotaMin.Value = ""
    txtNotaMax.Value = ""
    ClearFilters
    UpdateTableFromFiltered
End Sub

Private Sub btnExportar_Click()
    If Not DataLoaded Then
        MsgBox "Nenhum dado para exportar!", vbExclamation
        Exit Sub
    End If
    Dim ok As Boolean
    ok = ExportFilteredToFile("ENEM_Filtrados_" & Format(Now, "yyyy-mm-dd_hh-nn-ss"))
    If ok Then
        MsgBox "✅ Dados exportados com sucesso!", vbInformation
    Else
        MsgBox "❌ Erro ao exportar.", vbExclamation
    End If
End Sub
